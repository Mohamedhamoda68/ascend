// ============================================

const THEME_KEY = 'ascend:theme';
const DEFAULT_THEME = 'dark';

console.log('🎨 [theme.js] Loaded');

const ICON_SUN = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>`;
const ICON_MOON = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>`;

function getCurrentTheme() {
  try {
    const saved = localStorage.getItem(THEME_KEY);
    if (saved === 'light' || saved === 'dark') return saved;
  } catch (e) {}
  return DEFAULT_THEME;
}

function applyTheme(theme) {
  console.log('🎨 [theme.js] Applying theme:', theme);
  document.documentElement.setAttribute('data-theme', theme);
  if (document.body) document.body.setAttribute('data-theme', theme);

  const meta = document.querySelector('meta[name="theme-color"]');
  if (meta) meta.setAttribute('content', theme === 'light' ? '#F7F8FC' : '#050506');

  document.querySelectorAll('[data-theme-toggle]').forEach(btn => {
    updateToggleIcon(btn, theme);
  });
}

function saveTheme(theme) {
  try { localStorage.setItem(THEME_KEY, theme); } catch (e) {}
}

function updateToggleIcon(btn, theme) {
  if (!btn) return;
  const label = theme === 'light' ? 'تبديل للوضع الداكن' : 'تبديل للوضع الفاتح';
  btn.setAttribute('aria-label', label);
  btn.innerHTML = theme === 'light' ? ICON_MOON : ICON_SUN;
}

export function createThemeToggle(options = {}) {
  const { className = 'icon-btn theme-toggle', style = '' } = options;

  const btn = document.createElement('button');
  btn.type = 'button';
  btn.className = className;
  btn.setAttribute('data-theme-toggle', 'true');
  if (style) btn.setAttribute('style', style);

  btn.addEventListener('click', (e) => {
    e.preventDefault();
    e.stopPropagation();
    const current = getCurrentTheme();
    const next = current === 'dark' ? 'light' : 'dark';
    console.log('🎨 [theme.js] Toggle clicked →', next);
    saveTheme(next);
    applyTheme(next);
  });

  updateToggleIcon(btn, getCurrentTheme());
  return btn;
}

export function autoInjectThemeToggle() {
  console.log('🎨 [theme.js] Auto-injecting toggle...');
  
  const targets = ['.legend-topbar-actions', '.topbar-actions', '.nav-menu'];

  for (const selector of targets) {
    const target = document.querySelector(selector);
    if (target) {
      console.log('🎨 [theme.js] Found target:', selector);
      
      if (target.querySelector('[data-theme-toggle]')) {
        console.log('🎨 [theme.js] Toggle already exists');
        return;
      }

      const toggle = createThemeToggle({
        className: target.closest('.legend-topbar') ? 'legend-icon-btn' : 'icon-btn'
      });

      const lastBtn = target.querySelector('.legend-icon-btn.avatar, .user-chip, button:last-child');
      if (lastBtn && lastBtn.parentElement === target) {
        target.insertBefore(toggle, lastBtn);
      } else {
        target.appendChild(toggle);
      }
      console.log('🎨 [theme.js] Toggle injected ✅');
      return;
    }
  }
  console.warn('🎨 [theme.js] No target found for toggle');
}

export function initTheme() {
  console.log('🎨 [theme.js] Init...');
  applyTheme(getCurrentTheme());

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', autoInjectThemeToggle);
  } else {
    autoInjectThemeToggle();
  }
}

initTheme(); 
